{
  "name": "@flora-ai/flora",
  "version": "0.21.1",
  "description": "The official TypeScript SDK for the FLORA API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florafauna-ai/flora-typescript.git"
  },
  "homepage": "https://docs.flora.ai",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "oxlint --type-aware --max-warnings=0 --config ./.oxlintrc.json .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings=0 --config ./.oxlintrc.json .",
    "test:unit": "vitest run --reporter=dot --silent",
    "test:unit:src": "vitest run --reporter=dot --silent",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test:unit && pnpm run knip"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "knip": "^6.11.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.4"
}
