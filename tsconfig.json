{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // Node's ESM loader resolves a .ts import only when it is spelled out, and
    // type checks run without emit, so the spelling is free.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ESNext",
    // ES2022 rather than ESNext: the generated fetch polyfill's iterators don't
    // satisfy esnext's iterator-helper `HeadersIterator` shape.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "scripts", "knip.config.ts", "vitest.config.ts"]
}
